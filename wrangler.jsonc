// Cloudflare Workers deployment (in parallel to Netlify, see netlify.toml).
// Serves the vite build output as static assets: no Worker code runs, so requests are free and
// don't count towards the Workers request limits.
// public/_headers applies as is. Netlify's redirects live in netlify.toml (not public/_redirects),
// so that Cloudflare doesn't pick them up.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "releases",
  "compatibility_date": "2026-11-01",
  // No Preview or Version URLs (<branch|version>-releases.<subdomain>.workers.dev): GitHub login
  // only works on hosts listed in Firebase Auth's authorized domains, which can't be wildcards.
  // Explicit, because when omitted the setting follows workers_dev (on). Preview builds are also off
  // in Workers Builds (dashboard), so only master deploys.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Client-side routes (/releases, /settings, ...) get index.html with 200, the same as the
    // `/releases /index.html 200` rules in public/_redirects on Netlify
    "not_found_handling": "single-page-application",
  },
}
