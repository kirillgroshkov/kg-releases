{
  "name": "releases",
  "type": "module",
  "version": "1.0.0",
  "author": "kirillgroshkov <kirill.groshkov5@gmail.com>",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "upd": "pnpm up --no-save",
    "upd2": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm up --no-save",
    "build": "vite build",
    "test": "dev-lib test",
    "lint": "dev-lib lint",
    "check": "dev-lib check && vite build",
    "dev": "vite --port 4100 --open",
    "build-netlify": "vite build",
    "preview": "vite preview --open"
  },
  "dependencies": {
    "@mdi/js": "^7",
    "@naturalcycles/js-lib": "^15",
    "@preact/signals": "^2",
    "@sentry/browser": "^11",
    "firebase": "^13",
    "preact": "^11",
    "preact-iso": "^2",
    "tslib": "^2"
  },
  "devDependencies": {
    "@naturalcycles/dev-lib": "^20",
    "@naturalcycles/nodejs-lib": "^15",
    "@prefresh/core": "^1.5",
    "@prefresh/utils": "^1.2",
    "@prefresh/vite": "^4",
    "@types/node": "^26",
    "husky": "^9",
    "tsx": "^4",
    "typescript": "^7",
    "vite": "^8",
    "vite-bundle-analyzer": "^1",
    "vitest": "^5"
  },
  "imports": {
    "#src/*.js": "./src/*.ts",
    "#src/*.jsx": "./src/*.tsx",
    "#src/*": "./src/*"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.17.0"
}
