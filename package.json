{
  "name": "releases",
  "type": "module",
  "version": "1.0.0",
  "author": "kirillgroshkov <kirill.groshkov5@gmail.com>",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "upd": "pnpm up --no-save",
    "upd2": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm up --no-save",
    "build": "vite build",
    "test": "dev-lib test",
    "lint": "dev-lib lint",
    "bt": "dev-lib typecheck && vue-tsc --noEmit && pnpm build",
    "check": "dev-lib lint && pnpm bt",
    "dev": "vite --port 4100 --open",
    "build-netlify": "vite build",
    "preview": "vite preview --open"
  },
  "dependencies": {
    "@mdi/js": "^7",
    "@naturalcycles/js-lib": "^15",
    "@sentry/vue": "^11",
    "@vueuse/core": "^15",
    "firebase": "^13",
    "pinia": "^4",
    "tslib": "^2",
    "vue": "^3",
    "vue-router": "^5",
    "vuetify": "^4"
  },
  "devDependencies": {
    "@naturalcycles/dev-lib": "^20",
    "@naturalcycles/nodejs-lib": "^15",
    "@types/node": "^26",
    "@typescript/native-preview": "beta",
    "@vitejs/plugin-vue": "^6",
    "husky": "^9",
    "sass": "^1",
    "tsx": "^4",
    "typescript": "~6.0",
    "vite": "^8",
    "vite-bundle-analyzer": "^1",
    "vite-plugin-vuetify": "^2",
    "vue-tsc": "^3"
  },
  "imports": {
    "#src/*.js": "./src/*.ts",
    "#src/*": "./src/*"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@12.15.0"
}
